<!-- 6. Comparison Table -->
<section class="py-stack-lg px-margin-desktop max-w-container-max mx-auto overflow-x-auto">
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b border-secondary-container">
        <th class="py-6 text-left font-headline-md text-headline-md">Comparison</th>
        <th class="py-6 text-center font-headline-md text-headline-md text-primary">BIOAQUA Clinical</th>
        <th class="py-6 text-center font-headline-md text-headline-md text-secondary">Generic Brands</th>
      </tr>
    </thead>
    <tbody class="font-body-md text-body-md">
      <tr class="border-b border-surface-container">
        <td class="py-6 font-semibold">Growth Acceleration</td>
        <td class="py-6 text-center text-primary">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span> Triple Peptide
        </td>
        <td class="py-6 text-center text-secondary">Basic Moisturizer</td>
      </tr>
      <tr class="border-b border-surface-container">
        <td class="py-6 font-semibold">Density Improvement</td>
        <td class="py-6 text-center text-primary">+82% Clinical Proof</td>
        <td class="py-6 text-center text-secondary">None Measured</td>
      </tr>
      <tr class="border-b border-surface-container">
        <td class="py-6 font-semibold">Eye Safety</td>
        <td class="py-6 text-center text-primary">Dermatologist Approved</td>
        <td class="py-6 text-center text-secondary">Potential Irritants</td>
      </tr>
      <tr>
        <td class="py-6 font-semibold">Investment Value</td>
        <td class="py-6 text-center text-primary font-bold">Premium Efficacy</td>
        <td class="py-6 text-center text-secondary">Budget Formulation</td>
      </tr>
    </tbody>
  </table>
</section>

