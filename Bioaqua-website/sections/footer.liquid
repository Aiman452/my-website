<!-- 12. Footer -->
<footer class="w-full bg-surface-container-lowest border-t border-secondary-container" style="background-color: var(--surface-container-lowest); border-top: 1px solid var(--secondary-container); width: 100%;">
  <div class="flex flex-col items-center gap-stack-lg px-margin-desktop py-stack-lg max-w-container-max mx-auto" style="display: flex; flex-direction: column; align-items: center; gap: 48px; padding-top: 48px; padding-bottom: 48px;">
    <div class="font-display-lg text-display-lg-mobile text-primary" style="color: var(--primary);">
      {{ section.settings.footer_brand | default: 'BIOAQUA' }}
    </div>
    <div class="flex flex-wrap justify-center gap-8" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 32px;">
      <a class="font-body-md text-body-md text-secondary hover:text-primary transition-colors" href="#">Secure Checkout</a>
      <a class="font-body-md text-body-md text-secondary hover:text-primary transition-colors" href="#">Privacy Policy</a>
      <a class="font-body-md text-body-md text-secondary hover:text-primary transition-colors" href="#">Terms of Service</a>
      <a class="font-body-md text-body-md text-secondary hover:text-primary transition-colors" href="#">Contact Us</a>
    </div>
    <div class="font-body-md text-body-md text-secondary">
      © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'BIOAQUA Clinical Care. All Rights Reserved.' }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_brand",
      "label": "Brand Title",
      "default": "BIOAQUA"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "BIOAQUA Clinical Care. All Rights Reserved."
    }
  ]
}
{% endschema %}
