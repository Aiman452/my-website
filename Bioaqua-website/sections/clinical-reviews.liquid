<!-- 7. Dual Testimonial Sliders -->
<section id="reviews" class="bg-surface-container-low py-stack-lg">
  <div class="max-w-container-max mx-auto px-margin-desktop">
    <h2 class="font-headline-md text-headline-md text-center mb-12">
      {{ section.settings.title | default: 'Verified Clinical Experiences' }}
    </h2>
    <div class="grid md:grid-cols-2 gap-gutter">
      <!-- Text Reviews -->
      <div class="bg-surface-container-lowest p-10 border border-secondary-container">
        <div class="flex gap-1 mb-4">
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
        </div>
        <p class="font-body-lg text-body-lg italic mb-6">
          "{{ section.settings.quote | default: "I've tried every serum on the market, but nothing compares to the precision of the BIOAQUA brush. My lashes feel stronger and noticeably darker within two weeks." }}"
        </p>
        <div class="font-button text-button uppercase text-primary">
          {{ section.settings.author | default: '— Dr. Elena Sterling, Dermatologist' }}
        </div>
      </div>
      <!-- Photo Results -->
      <div class="relative group overflow-hidden">
        <div class="grid grid-cols-2 gap-2 h-full">
          <div class="relative aspect-[3/4]">
            <img class="w-full h-full object-cover" 
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuDXfh_UWDLZiFco_pl-vro43Yo4JU3LVwg_gq84KIY1bidvoiSBbipnUNtdYeXVV4-r7r2WazjlKvtVtSJHy30-owzU-Xwp8zwvGFVOvfPIP4OEmM5Sl28f4S78noMudiOyB__5OgJkT_HsZIHaUjqUcOlBLkzf6sgvro5L1tGJAJqNYolEBQrmNuHnKB0ozh6NzLAlxcEZR-miOoIkiz7RygFPAKO_ReLSHFMRGWvvX_RBkZPnvLgeK15s4291n6_FD9iyC7gHCW0" 
                 alt="Clinical Before Eyelashes Day 1" />
            <div class="absolute bottom-4 left-4 bg-white/80 px-3 py-1 font-label-sm text-label-sm uppercase">Day 1</div>
          </div>
          <div class="relative aspect-[3/4]">
            <img class="w-full h-full object-cover" 
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0NAqTdQtDZv8kmAzijEzOj6y9llUmhDRpCzcLeKEuH7etXxjBxiifeYQMIKEirSZCw0WD1C9ocuv448OIVjNJNl3UHEOYDsmWLEYawZr6jFc6-DaYKyzbr0fk9_E4ANqll26oTLF2IDS8_Ipzb92i-Gr_oHDn0EGHzCIShv2sA_TNWdyxXzW-tUo7kvpZvcirQ-7H0NVcAtZ8dj_wXmezcLPLYZHIAM-ggIUyueIIzTVFgpVXmPNxGQgG6C5rir14PcOKWz1x6Tc" 
                 alt="Clinical After Eyelashes Day 14" />
            <div class="absolute bottom-4 left-4 bg-primary text-white px-3 py-1 font-label-sm text-label-sm uppercase">Day 14</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clinical Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Verified Clinical Experiences"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "I've tried every serum on the market, but nothing compares to the precision of the BIOAQUA brush. My lashes feel stronger and noticeably darker within two weeks."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "— Dr. Elena Sterling, Dermatologist"
    }
  ]
}
{% endschema %}
