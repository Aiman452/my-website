<!-- 8. Background Image Block -->
<section class="relative py-48 w-full" style="position: relative; padding-top: 192px; padding-bottom: 192px; width: 100%;">
  <div class="absolute inset-0 z-0" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0;">
    <img class="w-full h-full object-cover grayscale-[0.2] brightness-90" 
         style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.2) brightness(0.9);"
         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxdyTRHL0rX3ShLuNXT6Tkr0U19C4TazNtthYd0vDLfiO0JkXQqsJ2fugnBU7lE2eQKcQ608ivghSd9DN4EsyRGnRidG7FgVm-u3Y3dYzb0iLSLX1LspqSPF4_v5RgcH0V5DF5fgFQUzz7L8HwgNvQ1D4hN5H7or7BWgfN4InYSJdG9fj9NtLPyhBMzPvDFP7EI3pnfyXzhnGYyHzwsDTmIxkJ5_8tswpJdlFCkgOJNVq6WdpKeb2VOJ2SleMB7N9WTVeuS8VQtUY" 
         alt="Uncompromising Quality Background" />
  </div>
  <div class="relative z-10 max-w-container-max mx-auto px-margin-desktop text-center" style="position: relative; z-index: 10; text-align: center;">
    <div class="bg-white/20 backdrop-blur-lg border border-white/30 inline-block p-12 max-w-2xl" style="background-color: rgba(255, 255, 255, 0.2); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.3); display: inline-block; padding: 48px; max-width: 672px;">
      <h2 class="font-display-lg text-display-lg text-white mb-6" style="color: #ffffff; margin-bottom: 24px;">
        {{ section.settings.title | default: 'Uncompromising Quality.' }}
      </h2>
      <p class="font-body-lg text-body-lg text-white mb-10" style="color: #ffffff; margin-bottom: 40px; line-height: 1.6;">
        {{ section.settings.description | default: "Our signature purple packaging isn't just about style—it's a seal of authenticity and pharmaceutical-grade safety." }}
      </p>
      <button onclick="handleAddToCartClick(this)" class="bg-white text-primary px-12 py-4 font-button text-button uppercase tracking-wider hover:bg-surface-container-high transition-colors cursor-pointer border-0" style="background-color: #ffffff; color: var(--primary); padding: 16px 48px; border: none; font-weight: 700; cursor: pointer;">
        {{ section.settings.btn_text | default: 'Claim Your Supply' }}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Packaging Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Uncompromising Quality."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our signature purple packaging isn't just about style—it's a seal of authenticity and pharmaceutical-grade safety."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Claim Your Supply"
    }
  ]
}
{% endschema %}
