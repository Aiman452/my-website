<!doctype html>
<html class="scroll-smooth" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="BIOAQUA Nourishing Liquid Eyelashes - Clinical Precision, triple-peptide complex formula for rapid lash growth.">
    {% endif %}

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Inter:wght@400;600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Standalone Clinical CSS (Runs natively without external CDN delays) -->
    {{ 'bioaqua.css' | asset_url | stylesheet_tag }}

    <!-- Tailwind Play CDN (Optional Enhancement) -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
              "surface-container-high": "#e8e8e8",
              "surface-container-lowest": "#ffffff",
              "inverse-surface": "#2f3131",
              "on-primary-container": "#fbe9ff",
              "on-tertiary-container": "#efeeee",
              "on-secondary-fixed-variant": "#474646",
              "surface-tint": "#7b489d",
              "on-primary-fixed": "#2f004c",
              "background": "#f9f9f9",
              "surface-variant": "#e2e2e2",
              "on-surface-variant": "#4c444f",
              "secondary-fixed": "#e5e2e1",
              "secondary-container": "#e5e2e1",
              "on-error-container": "#93000a",
              "error": "#ba1a1a",
              "surface-bright": "#f9f9f9",
              "outline-variant": "#cfc3d1",
              "inverse-primary": "#e4b5ff",
              "surface-container-highest": "#e2e2e2",
              "tertiary-fixed": "#e2e2e2",
              "on-background": "#1a1c1c",
              "secondary": "#5f5e5e",
              "primary-fixed": "#f4daff",
              "on-secondary": "#ffffff",
              "surface-container": "#eeeeee",
              "surface": "#f9f9f9",
              "tertiary-fixed-dim": "#c6c6c6",
              "primary-container": "#8a56ac",
              "outline": "#7e7481",
              "error-container": "#ffdad6",
              "on-tertiary-fixed": "#1a1c1c",
              "on-primary": "#ffffff",
              "surface-dim": "#dadada",
              "on-secondary-fixed": "#1c1b1b",
              "surface-container-low": "#f3f3f4",
              "on-primary-fixed-variant": "#612f83",
              "tertiary": "#535454",
              "inverse-on-surface": "#f0f1f1",
              "secondary-fixed-dim": "#c8c6c5",
              "on-surface": "#1a1c1c",
              "tertiary-container": "#6b6c6c",
              "on-tertiary": "#ffffff",
              "on-tertiary-fixed-variant": "#454747",
              "primary": "#703d91",
              "on-error": "#ffffff",
              "on-secondary-container": "#656464",
              "primary-fixed-dim": "#e4b5ff"
            },
            "borderRadius": {
              "DEFAULT": "0.125rem",
              "lg": "0.25rem",
              "xl": "0.5rem",
              "full": "0.75rem"
            },
            "spacing": {
              "unit": "8px",
              "stack-lg": "48px",
              "margin-desktop": "64px",
              "container-max": "1280px",
              "stack-md": "24px",
              "margin-mobile": "16px",
              "gutter": "24px",
              "stack-sm": "8px"
            },
            "fontFamily": {
              "label-sm": ["Inter"],
              "button": ["Montserrat"],
              "body-lg": ["Inter"],
              "headline-md": ["Montserrat"],
              "display-lg": ["Montserrat"],
              "body-md": ["Inter"],
              "display-lg-mobile": ["Montserrat"]
            },
            "fontSize": {
              "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
              "button": ["14px", {"lineHeight": "20px", "letterSpacing": "0.02em", "fontWeight": "700"}],
              "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
              "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
              "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
              "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
              "display-lg-mobile": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700"}]
            }
          }
        }
      }
    </script>

    {{ content_for_header }}
  </head>

  <body class="bg-surface-container-lowest text-on-surface antialiased">
    {% section 'header' %}

    <main id="MainContent" class="pt-20">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}

    {{ 'bioaqua.js' | asset_url | script_tag }}
  </body>
</html>
