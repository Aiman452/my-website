<div id="cart-drawer-backdrop" class="drawer-backdrop fixed inset-0 z-50 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="cart-drawer-panel" class="drawer-content fixed top-0 right-0 w-full max-w-md h-full bg-white shadow-2xl flex flex-col translate-x-full">
    <!-- Header -->
    <div class="p-6 border-b border-secondary-container flex items-center justify-between bg-surface-container-low">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">shopping_bag</span>
        <h3 class="font-headline-md text-lg font-bold text-on-surface">Your Order Summary</h3>
      </div>
      <button onclick="closeCartDrawer()" class="text-secondary hover:text-on-surface p-1 rounded-full hover:bg-surface-container">
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>

    <!-- Free Shipping Notice -->
    <div class="bg-primary-fixed/40 px-6 py-3 border-b border-primary-fixed">
      <p class="text-xs font-semibold text-primary flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">local_shipping</span>
        Congratulations! Free Clinical Shipping Applied
      </p>
    </div>

    <!-- Cart Items Body -->
    <div class="p-6 flex-1 overflow-y-auto space-y-4" id="cart-items-container">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="flex gap-4 p-4 border border-secondary-container rounded bg-white">
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-20 h-20 object-cover rounded border border-secondary-container"/>
            <div class="flex-1 flex flex-col justify-between">
              <div>
                <h4 class="font-button text-sm font-bold text-on-surface">{{ item.product.title }}</h4>
                <p class="text-xs text-secondary">{{ item.variant.title }}</p>
              </div>
              <div class="flex items-center justify-between mt-3">
                <span class="text-xs text-secondary">Qty: {{ item.quantity }}</span>
                <span class="font-button text-sm font-bold text-primary">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default sample item so the preview looks complete -->
        <div class="flex gap-4 p-4 border border-secondary-container rounded bg-white">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBZN_Jip3VplcYeacH4nwqRZo05hT6BJC0-NWoY4UfAshg_kEnDkmxoPvBAm5Op8P74AtWvK7tZGSxDdoM2xx8O9_giPYA5HkikdyOF8HswC08PZ5kt4gkM4kQUsVN5z2sSSbliSBplTtI_r9fbzHtLHSCuoeVDS72QGFkztCHBLIlWjuczajhV4kCnEO3ZIASapUmJ9JNbxm4hf5pD5dC5J__CEQglDYn2f15l6QoGDOK9iy6xn5KqRfVUxzL_fhlvDzGmTa9sMH4" 
               alt="BIOAQUA Nourishing Liquid Eyelashes" 
               class="w-20 h-20 object-cover rounded border border-secondary-container"/>
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start">
                <h4 class="font-button text-sm font-bold text-on-surface">BIOAQUA Lash Serum</h4>
              </div>
              <p class="text-xs text-secondary">Nourishing Liquid • 7ml</p>
            </div>
            <div class="flex items-center justify-between mt-3">
              <span class="text-xs text-secondary font-medium">Qty: 1</span>
              <span class="font-button text-sm font-bold text-primary">$24.99</span>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Footer / Checkout -->
    <div class="p-6 border-t border-secondary-container bg-surface-container-low space-y-4">
      <div class="space-y-1.5 text-sm">
        <div class="flex justify-between text-secondary">
          <span>Subtotal</span>
          <span>{{ cart.total_price | default: 2499 | money }}</span>
        </div>
        <div class="flex justify-between text-secondary">
          <span>Clinical Shipping</span>
          <span class="text-green-600 font-semibold uppercase text-xs">Free</span>
        </div>
      </div>

      <a href="/checkout" class="w-full bg-primary hover:bg-primary-container text-white py-4 font-button text-button uppercase tracking-wider font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 text-center">
        <span class="material-symbols-outlined text-base">lock</span>
        Proceed to Shopify Checkout
      </a>

      <p class="text-[11px] text-center text-secondary flex items-center justify-center gap-1">
        <span class="material-symbols-outlined text-xs">verified_user</span>
        Guaranteed safe & secure Shopify checkout
      </p>
    </div>
  </div>
</div>
